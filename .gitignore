# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# ──────────────────────────────────────────────
# Proyecto Tesis — datos personales y locales
# ──────────────────────────────────────────────

# Cache del scraping SUM: contiene DNI, correos, direccion, celular, ponderado y
# todo el historial academico del alumno. NUNCA debe estar en git.
data/cache.json
data/cache_*.json
data/users/

# Preferencias manuales del alumno (docentes, horarios, etc). Personal por alumno.
data/preferencias_*.json

# Ranking ponderado: datos de 1541 alumnos (codigo + ponderado). No subir a repo publico.
data/ranking_ponderado_*.csv
pdf/

# PDFs y documentos personales (historial academico, constancias, etc.)
HISTORIAL DATA/
*.pdf

# Configuracion local de Claude Code / asistentes IDE
.claude/

# Outputs del GA (horarios exportados con datos del alumno)
output/*.xlsx
output/*.pdf
output/*.png
output/*.html

# Documentos de contexto (para asistentes LLM, redaccion de tesis, o
# snapshots historicos del avance del proyecto). Personales del autor;
# no se versionan. El README.md queda como unica documentacion publica.
CONTEXTO_*.md
